PORT=4000
CORS_ORIGIN=http://localhost:3000
# Set only if deployed behind a reverse proxy/load balancer (Render, Fly, nginx, etc.) — enables
# `req.ip` (used by the /api/leads rate limiter) to read the real client IP from X-Forwarded-For.
# Value is passed straight to Express's `trust proxy` setting — e.g. "1" for a single proxy hop,
# or a specific proxy IP/CIDR. Leave unset for local dev. https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

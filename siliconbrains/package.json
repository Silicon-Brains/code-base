{
  "name": "siliconbrains",
  "private": true,
  "workspaces": ["apps/web", "apps/server"],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:server\"",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=apps/server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
